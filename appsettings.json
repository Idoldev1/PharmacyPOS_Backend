{
  "ConnectionStrings": {
    "DefaultConnection": "Server=PSALMSON\\SQLEXPRESS;Database=PHARMACYPOSDB;Trusted_Connection=true;MultipleActiveResultSets=true;TrustServerCertificate=true"
  },
  "Jwt": {
    "Key": "SuperSecretSigningKeyForDemoPurposesOnly12345",
    "Issuer": "pos-api",
    "Audience": "pos-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ResetTokenMinutes": 30
  },
  "Sales": {
    "PendingSaleExpiryMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "None"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/pos_api-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({TraceId}) {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-gmail@gmail.com",
    "Password": "your-app-password",
    "FromEmail": "your-gmail@gmail.com",
    "FromName": "HealthPlus Pharmacy"
  },
  "AllowedHosts": "*"
}
